# ═══════════════════════════════════════════════════════════════════
# SMT EstudIA — variables de entorno (EJEMPLO: sin valores reales)
#
# Copiá este archivo a .env.local y completalo. .env.local no va al repo
# (el repo es público). En Vercel, las mismas variables van en
# Settings → Environment Variables.
# ═══════════════════════════════════════════════════════════════════

# ── La app (se meten en el código al compilar: son PÚBLICAS) ──
# El servidor de datos (Supabase propio) y su clave pública ("anon").
# Los valores salen de: ssh ... estudia@<servidor> bin/clave-publica
VITE_SUPABASE_URL=https://<servidor-de-datos>
VITE_SUPABASE_ANON_KEY=<clave-publica-anon>

# Opcionales
# VITE_DNI_EMAIL_DOMAIN=alumnos.estudia.smt.gob.ar
# VITE_PUBLIC_URL=https://estudia.smt.gob.ar
# VITE_DEMO_LOGIN=false


# ── Ingreso con CiDiTuc (solo del lado del servidor: api/_cidituc.ts) ──
# Ninguna de estas empieza con VITE_: no llegan al navegador.

# Dónde está Ciudad Digital (la pantalla de CUIL y clave de CiDiTuc; repo
# ditec-desarrollo/cidituc). Hasta noviembre de 2026 era el derivador.
#   Producción: https://ciudaddigital.smt.gob.ar
#   Local: donde corra Ciudad Digital (Vite)
# Con o sin "/#" al final: Ciudad Digital usa rutas con # y EstudIA arma sola
# la dirección de su pantalla de ingreso (<esta-url>/?ingreso=…#/login?next=...).
CIDITUC_LOGIN_URL=<url-de-ciudad-digital>

# El backend de CiDiTuc que valida el token (GET /usuarios/authStatus).
CIDITUC_BACKEND_URL=<url-del-backend-de-cidituc>

# La clave con la que Ciudad Digital reconoce a EstudIA (?next=; hoy, estudia).
# Tiene que estar registrada en Ciudad Digital (src/routes/PrivateRoute.jsx,
# CALLBACK_ESTUDIA), con la vuelta a <este-dominio>/auth/cidituc/callback.
CIDITUC_NEXT_KEY=<CLAVE_NEXT>

# Firma las cookies del ingreso. Largo y al azar (32 caracteres o más):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CIDITUC_SESSION_SECRET=<secreto-largo-al-azar>

# Clave compartida con la función cidituc-sesion del servidor de datos, la
# única que puede pedirle una sesión. Tiene que ser la MISMA que quedó en el
# servidor (bin/clave-cidituc, en el servidor, la genera y la muestra).
CIDITUC_PUENTE_SECRET=<clave-compartida-con-el-servidor>

# El backend municipal manda la cadena TLS incompleta: acá va lo que falta
# (el certificado intermedio, en PEM). Nunca se apaga la verificación TLS.
#   En Vercel: el PEM entero en CIDITUC_CA_PEM.
#   En local: la ruta a un archivo en CIDITUC_CA_FILE, o arrancar con
#   NODE_EXTRA_CA_CERTS=<ruta-al-pem> npm run dev
# CIDITUC_CA_PEM=<-----BEGIN CERTIFICATE----- ...>
# CIDITUC_CA_FILE=<ruta-al-pem>
